<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 和 rc-speaker-tile 的 PWProbe 一致：只注入有 UIApplication 的进程，
         也就是用户能点开的 App。daemon 和 SpringBoard 里没有要抓的 BLE 通信，
         注进去只会拖慢系统。
         真正装不装 hook，由 AxsBLELoggerHookStart 再判一次（跳过 com.apple.*）。 -->
    <key>Filter</key>
    <dict>
        <key>Classes</key>
        <array>
            <string>UIApplication</string>
        </array>
    </dict>
</dict>
</plist>
