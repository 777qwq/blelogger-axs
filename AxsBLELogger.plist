<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 两部分，OR 关系：
         Bundles 显式点名 SpringBoard —— 直连扫描跑在这里。
         Classes 覆盖所有有 UIApplication 的进程，也就是用户能点开的 App。
         真正装什么由 AxsBLELoggerHookStart 按 bundle id 再分一次：
         springboard 走扫描，com.apple.* 直接退出，其余装 CoreBluetooth hook。 -->
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <string>com.apple.springboard</string>
        </array>
        <key>Classes</key>
        <array>
            <string>UIApplication</string>
        </array>
    </dict>
</dict>
</plist>
